---
type Props = { date: Date | string };

const { date } = Astro.props;
---

{
    typeof date === 'string' ? (
        <time>{date}</time>
    ) : (
        <time datetime={date.toISOString()}>
            {
                date.toLocaleDateString('en-us', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                })
            }
        </time>
    )
}
