---
import type { GetStaticPathsOptions, Page } from 'astro';
import { type CollectionEntry, getCollection } from 'astro:content';
import ExperiencePreview from '../../../components/ExperiencePreview.astro';
import Pagination from '../../../components/Pagination.astro';
import Subscribe from '../../../components/Subscribe.astro';
import siteConfig from '../../../data/site-config';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllTags, getExperiencesByTag, sortItemsByDateDesc } from '../../../utils/data-utils';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    const experiences = (await getCollection('experience')).sort(sortItemsByDateDesc);
    const tags = getAllTags(experiences);

    return tags.flatMap((tag) => {
        const filteredExperiences = getExperiencesByTag(experiences, tag.id);
        return paginate(filteredExperiences, {
            params: { id: tag.id },
            pageSize: siteConfig.experiencesPerPage || 4
        });
    });
}

type Props = { page: Page<CollectionEntry<'experience'>> };

const { page } = Astro.props;
const experiences = page.data;
const params = Astro.params;
const allExperiences = await getCollection('experience');
const allTags = getAllTags(allExperiences);
const currentTag = allTags.find((tag) => {
    return tag.id === params.id;
});
---

<BaseLayout title={`Entries Tagged ${currentTag?.name}`} description={`Explore work experience entries tagged under ${currentTag?.name}`} showHeader={false}>
    <h1 class="mb-12 font-serif text-2xl leading-tight italic sm:mb-16 sm:text-4xl">Entries Tagged "{currentTag?.name}"</h1>
    {experiences.map((experience) => <ExperiencePreview experience={experience} class="mb-10 sm:mb-12" />)}
    <Pagination page={page} class="my-16 sm:my-24" />
    <Subscribe class="my-16 sm:my-24" />
</BaseLayout>
